{
  "name": "desktop-image-tool",
  "version": "1.0.0",
  "description": "Node.js desktop image management tool with folder sorting by file count",
  "main": "dist-electron/main.js",
  "scripts": {
    "lint": "eslint . --ext .ts,.js,.vue",
    "lint:fix": "eslint . --ext .ts,.js,.vue --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,md}\"",
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "clean": "rimraf dist dist-electron",
    "electron": "electron dist-electron/main.js",
    "start": "npm run build && npm run electron"
  },
  "keywords": [
    "electron",
    "vue",
    "image-tool",
    "desktop"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "sharp": "^0.34.5",
    "vue": "^3.4.0",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "vite": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "@typescript-eslint/parser": "^7.12.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "prettier": "^3.3.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.0"
  }
}
